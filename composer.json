{
    "name": "spyderbotlabs/spb-wordpress",
    "description": "SpyderBot Tracking WordPress plugin",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "classmap": [
            "includes/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "SpyderBot\\Tracking\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "build-zip": "bash bin/build-zip.sh"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "homepage": "https://github.com/spyderbotlabs/spb-wordpress",
    "support": {
        "issues": "https://github.com/spyderbotlabs/spb-wordpress/issues",
        "source": "https://github.com/spyderbotlabs/spb-wordpress"
    }
}
